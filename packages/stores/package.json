{
  "name": "@biga/stores",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "dependencies": {
    "@biga/types": "workspace:*",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biga/eslint-config": "workspace:*",
    "@biga/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "6.0.3"
  }
}
