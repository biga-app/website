{
  "name": "@biga/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biga/eslint-config": "workspace:*",
    "@biga/typescript-config": "workspace:*",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "6.0.3"
  }
}
