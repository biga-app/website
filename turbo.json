{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_BIGA_API_URL",
    "BIGA_SERVER_URL",
    "NEXT_OUTPUT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build",
        "web#check-types"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "@biga/types#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/stores#build": {
      "dependsOn": [
        "@biga/types#build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@biga/tests#test": {
      "dependsOn": [
        "@biga/types#build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "@biga/types#build",
        "@biga/stores#build"
      ]
    }
  }
}
